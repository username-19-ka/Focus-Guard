; Hoist all packages — required for React Native / Metro to resolve modules correctly
node-linker=hoisted

; Treat this directory as a standalone pnpm project.
; Prevents pnpm from traversing up to the monorepo root pnpm-workspace.yaml,
; which has settings (minimumReleaseAge, onlyBuiltDependencies, platform overrides)
; that break EAS build servers.
ignore-workspace-root-check=true

; Always write the lockfile here (not at the workspace root)
shared-workspace-lockfile=false

; Disable the release-age gate from the root workspace config
minimum-release-age=0

; Allow all packages to run their postinstall build scripts (needed for native modules)
ignore-scripts=false

{
  "expo": {
    "name": "FocusGuard",
    "slug": "focusguard-app",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "focusguard",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "jsEngine": "hermes",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E0F11"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.focusguard.app"
    },
    "android": {
      "package": "com.focusguard.app",
      "jsEngine": "hermes",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.PACKAGE_USAGE_STATS",
        "android.permission.QUERY_ALL_PACKAGES",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.WAKE_LOCK",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "FocusGuard uses the camera to count your exercise reps using pose detection.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-av",
      "expo-font",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "compileSdkVersion": 35,
            "targetSdkVersion": 34,
            "minSdkVersion": 24
          }
        }
      ],
      "./plugins/withUsageStatsManagerFix",
      "./plugins/withAppTrackingManifest"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "c7a9271a-c103-416e-82a3-fec63abe6441"
      }
    },
    "owner": "karimaa"
  }
}
